{
  "scripts": {
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "tsc": "tsc",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "run": "pnpm exec tsx",
    "seed": "pnpm exec tsx prisma/seed/index.ts",
    "seed:dev": "NODE_ENV=development pnpm exec tsx prisma/seed/index.ts",
    "seed:test": "NODE_ENV=test pnpm exec tsx prisma/seed/index.ts",
    "seed:prod": "NODE_ENV=production pnpm exec tsx prisma/seed/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:seed": "NODE_ENV=test jest --testPathPattern=seed"
  },
  "engines": {
    "node": ">20"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@faker-js/faker": "^10.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.5.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "prisma": "^6.16.1",
    "ts-jest": "^29.1.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "dotenv": "^17.2.2",
    "prettier": "^3.6.2"
  }
}
