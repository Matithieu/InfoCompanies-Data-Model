model City {
  id   Int     @id @default(autoincrement())
  name String?

  @@index([name], map: "ix_city_name")
  @@map("city")
}

model IndustrySector {
  id   Int     @id @default(autoincrement())
  name String?

  @@index([name], map: "ix_industry_sector_name")
  @@map("industry_sector")
}

model LegalForm {
  id   Int     @id @default(autoincrement())
  name String?

  @@index([name], map: "ix_legal_form_name")
  @@map("legal_form")
}

model Region {
  id   Int     @id @default(autoincrement())
  name String?

  @@index([name], map: "ix_region_name")
  @@map("region")
}
